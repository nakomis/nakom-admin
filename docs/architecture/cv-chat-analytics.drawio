<mxfile host="app.diagrams.net" type="device">
  <diagram name="cv-chat analytics" id="cvchat-analytics">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="cv.nakomis.com chat analytics — after the Aurora retirement (MULTI-4)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Vectors are produced by exactly one model — mxbai-embed-large (q8) on Cal. Nothing else in the estate embeds anything." style="text;html=1;fontSize=13;fontColor=#5A6C86;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="52" width="1000" height="22" as="geometry"/></mxCell>

        <mxCell id="awsCloud" value="AWS · eu-west-2" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="700" height="800" as="geometry"/></mxCell>

        <mxCell id="ddb" value="DynamoDB&#10;cv-chat-logs&#10;(record of truth)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="awsCloud"><mxGeometry x="60" y="70" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="fwd" value="Lambda&#10;cvchat-forward&#10;ADMIN-6" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="awsCloud"><mxGeometry x="290" y="70" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="age" value="age-encrypted&#10;to Cal's key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#ED7100;fontSize=10;fontColor=#7A4100;dashed=1;" vertex="1" parent="awsCloud"><mxGeometry x="270" y="176" width="110" height="34" as="geometry"/></mxCell>

        <mxCell id="sqs" value="SQS&#10;cv-chat-ingest&#10;+ DLQ" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="awsCloud"><mxGeometry x="530" y="70" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="s3" value="S3 payloads&#10;cvchat/ prefix&#10;(claim check)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" vertex="1" parent="awsCloud"><mxGeometry x="530" y="240" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="cf" value="CloudFront&#10;admin.nakomis.com" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="awsCloud"><mxGeometry x="60" y="470" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="cognito" value="Cognito&#10;user pool" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="awsCloud"><mxGeometry x="290" y="470" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="apigw" value="API Gateway&#10;/import/generate&#10;/logs/mine · /blocklist" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="awsCloud"><mxGeometry x="60" y="650" width="70" height="70" as="geometry"/></mxCell>

        <mxCell id="gone" value="RETIRED — ADMIN-9 / ADMIN-10&#10;&#10;Aurora Serverless v2 · VPC · isolated subnets&#10;rds-control · import-execute · query Lambda&#10;S3 staging bucket · Bedrock Titan embeddings&#10;&#10;Titan and mxbai are both 1024-dim: the column&#10;types match, so a restore would have compared&#10;vectors from two models and never errored." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9AA5B1;dashed=1;fontSize=11;fontColor=#6B7785;align=center;verticalAlign=middle;" vertex="1" parent="awsCloud"><mxGeometry x="270" y="620" width="330" height="140" as="geometry"/></mxCell>

        <mxCell id="home" value="Home network — nakomis.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F7A4D;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1F7A4D;container=1;collapsible=0;pointerEvents=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="960" height="800" as="geometry"/></mxCell>

        <mxCell id="leia" value="Leia — nginx&#10;api.cal.home.nakomis.com&#10;front TLS + mTLS client-cert gate&#10;CORS: home. + admin.nakomis.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#1F7A4D;fontSize=11;fontColor=#14532D;verticalAlign=middle;" vertex="1" parent="home"><mxGeometry x="60" y="420" width="230" height="90" as="geometry"/></mxCell>

        <mxCell id="cal" value="Cal — embedding-consumer (Rust)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#2F5CC4;fontSize=13;fontStyle=1;fontColor=#1B3A85;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;container=1;collapsible=0;pointerEvents=0;recursiveResize=0;" vertex="1" parent="home"><mxGeometry x="360" y="60" width="530" height="420" as="geometry"/></mxCell>

        <mxCell id="loop" value="Drain loop — HOME-301&#10;&#10;Polls the convmem and cv-chat queues in strict&#10;ALTERNATION, not tokio::select!. select! drops the&#10;losing future after SQS may already have made its&#10;messages invisible — a five-minute stall per record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5CC4;fontSize=10;fontColor=#1B3A85;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="cal"><mxGeometry x="25" y="40" width="290" height="110" as="geometry"/></mxCell>

        <mxCell id="ollama" value="Ollama&#10;mxbai-embed-large (q8)&#10;1024-dim · ~1.7 s/record&#10;serial, one embed at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B3005E;fontSize=10;fontColor=#7A0040;verticalAlign=middle;" vertex="1" parent="cal"><mxGeometry x="345" y="45" width="160" height="100" as="geometry"/></mxCell>

        <mxCell id="endpoints" value="HTTP :8090 — HOME-303/304&#10;&#10;POST /cvchat/stats · /cvchat/graph · /cvchat/neighbours&#10;POST /search  (conversation-memory)&#10;GET  /queue-status&#10;&#10;Cognito bearer token validated here, independently&#10;of the mTLS gate at Leia. Neither is sufficient alone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5CC4;fontSize=10;fontColor=#1B3A85;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="cal"><mxGeometry x="25" y="180" width="480" height="130" as="geometry"/></mxCell>

        <mxCell id="edges" value="On write: rebuild similar_pairs for the new row.&#10;The graph asks &quot;every pair above a threshold&quot; — no vector index answers that." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#A88600;fontSize=10;fontColor=#6B5500;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="cal"><mxGeometry x="25" y="330" width="480" height="60" as="geometry"/></mxCell>

        <mxCell id="luke" value="Luke — two separate postmasters, two logical volumes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#6B33C4;fontSize=13;fontStyle=1;fontColor=#3D1A80;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;container=1;collapsible=0;pointerEvents=0;recursiveResize=0;" vertex="1" parent="home"><mxGeometry x="360" y="540" width="530" height="220" as="geometry"/></mxCell>

        <mxCell id="analyticsdb" value="admin_analytics :5433&#10;HOME-299&#10;&#10;cv_chat_logs (vector 1024, HNSW)&#10;similar_pairs (id_a &lt; id_b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B33C4;fontSize=10;fontColor=#3D1A80;verticalAlign=middle;" vertex="1" parent="luke"><mxGeometry x="25" y="45" width="230" height="110" as="geometry"/></mxCell>

        <mxCell id="chatsdb" value="claude_chats :5432&#10;&#10;the operator's own corpus —&#10;a separate failure domain,&#10;deliberately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B33C4;fontSize=10;fontColor=#3D1A80;verticalAlign=middle;" vertex="1" parent="luke"><mxGeometry x="285" y="45" width="220" height="110" as="geometry"/></mxCell>

        <mxCell id="browser" value="Browser&#10;&#10;admin.nakomis.com → cv-chat tab&#10;home.nakomis.com → conversations tab&#10;&#10;client certificate + Cognito session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B8860B;fontSize=11;fontColor=#6B4E00;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="960" width="330" height="120" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ddb" target="fwd" value="Query, paginated"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fwd" target="sqs" value="envelope: id only"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7AA116;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#4F6B0E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fwd" target="s3" value="only if &gt; 200 KB"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E7157B;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=11;fontStyle=1;fontColor=#B3005E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs" target="loop" value="outbound poll — the house accepts no inbound connections"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7AA116;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#4F6B0E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="loop" value="GetObject"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B3005E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#7A0040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop" target="ollama" value="embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B33C4;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3D1A80;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop" target="analyticsdb" value="upsert (COALESCE every column)"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B33C4;strokeWidth=1;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#3D1A80;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loop" target="chatsdb" value="convmem pipeline"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B33C4;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#3D1A80;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="endpoints" target="analyticsdb" value="read-only pool"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1F7A4D;strokeWidth=3;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;fontSize=10;fontColor=#14532D;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="leia" target="endpoints" value="re-encrypted back leg&#10;https://cal.local:8443"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B8860B;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=11;fontStyle=1;fontColor=#6B4E00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="leia" value="POST /cvchat/* — Bearer token + client cert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#5B2FB0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cf" target="browser" value="SPA"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#9E2436;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cognito" target="browser" value="access token"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#B3005E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="apigw" value="SigV4 — blocklist, log miner, forward now"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#7A4100;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="apigw" target="fwd" value="invoke"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="key" value="Two independent gates, both required for /cvchat/*:&#10;  ① mTLS client certificate, enforced by nginx on Leia&#10;  ② Cognito access token, validated by Cal itself&#10;&#10;Visitor IP, user agent and message text are age-encrypted&#10;before they leave AWS. Only an opaque id travels in clear." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1200" y="960" width="470" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
